# Bilaspur News Intelligence - Environment Configuration
# Never commit actual values to the repository

# Database
DATABASE_URL=postgresql://user:password@localhost/bilaspur_news
# For local development with SQLite:
# DATABASE_URL=sqlite:///./data/bilaspur_news.db

# YouTube API (required for YouTube metadata collection)
YOUTUBE_API_KEY=

# Collection settings
COLLECTION_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Optional: OpenCode API key (for LLM summarization in later stages)
OPENCODE_API_KEY=

# Optional: GitHub Pages deployment
GITHUB_PAGES_TOKEN=